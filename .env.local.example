# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose in the browser (the anon key is meant to be public;
# it is protected by row-level security). The service_role key is NOT here on
# purpose — it must never ship to the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The faculty assistant (Teams → Assistant in the sidebar). Server-only: no
# NEXT_PUBLIC_ prefix, so it is never sent to the browser. Leave it blank and
# the assistant says it is not switched on; nothing else changes.
ANTHROPIC_API_KEY=
# Who may use it, by sign-in email, separated by commas. Owning a course is not
# enough — any account can make one. In production an EMPTY list means nobody
# (the assistant stays off); locally, empty lets any course owner try it.
ASSISTANT_ALLOWED_EMAILS=
# Optional. Which Claude model answers; defaults to claude-sonnet-5-5.
ASSISTANT_MODEL=
